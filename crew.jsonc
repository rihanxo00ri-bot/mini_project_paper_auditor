
{
  "name": "paper-auditor",

  "agents": [
    "comprehension_mind",
    "research_exploration_mind",
    "critical_evaluation_mind",
    "question_answerer"
  ],

  "tasks": [
    {
      "name": "build_comprehension_knowledge",
      "agent": "comprehension_mind",
      "description": "Analyze the research paper provided at {paper_path}. Build structured comprehension knowledge covering the research problem, objectives, concepts, terminology, prerequisites, methodology, mathematical elements, figures, tables, and relationships between concepts. Every knowledge item must include evidence references identifying the original page and supporting text. Do not produce a generic paper summary.",
      "expected_output": "Structured Comprehension Knowledge containing research anchor, concepts, prerequisites, methodology, mathematical elements, visual elements, comprehension requirements, and evidence references."
    },
    {
      "name": "build_research_exploration_knowledge",
      "agent": "research_exploration_mind",
      "description": "Analyze the same research paper at {paper_path}. Build structured research exploration knowledge covering research gaps, assumptions, unresolved problems, related research directions, comparisons, potential extensions, and future research opportunities. Distinguish explicitly stated facts from your own reasoned interpretations. Every finding must include evidence references where available. Do not invent literature or unsupported claims.",
      "expected_output": "Structured Research Exploration Knowledge containing research gaps, assumptions, unresolved problems, comparisons, potential extensions, future directions, confidence levels, and evidence references."
    },
    {
      "name": "build_critical_evaluation_knowledge",
      "agent": "critical_evaluation_mind",
      "description": "Critically evaluate the research paper at {paper_path}. Examine scientific claims, experimental design, methodology, datasets, baselines, evaluation metrics, statistical evidence, reproducibility, limitations, and internal inconsistencies. Identify unsupported conclusions and distinguish observed weaknesses from missing information. Assign severity and provide evidence references for every finding.",
      "expected_output": "Structured Critical Evaluation Knowledge containing claims, supporting evidence, methodological risks, experimental weaknesses, inconsistencies, severity, limitations, and evidence references."
    },
    {
      "name": "answer_user_question",
      "agent": "question_answerer",
      "context": [
        "build_comprehension_knowledge",
        "build_research_exploration_knowledge",
        "build_critical_evaluation_knowledge"
      ],
      "description": "Interpret the user's question from {user_question}. Identify its intent, terminology, and required knowledge. Consult the relevant findings from the three specialist minds. Resolve their evidence references against the original research paper. Answer using verified paper evidence, clearly distinguish paper statements from interpretations, and state when the paper does not provide sufficient evidence. Do not invent answers.",
      "expected_output": "A direct, well-reasoned answer containing the question interpretation, relevant specialist knowledge, supporting original-paper evidence with page references, reasoning, and uncertainty where applicable."
    }
  ],

  "process": "sequential",
  "verbose": true,
  "memory": false,

  "inputs": {
    "paper_path": "",
    "user_question": ""
  }
}
